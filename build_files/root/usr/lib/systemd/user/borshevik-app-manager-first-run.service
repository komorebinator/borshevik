[Unit]
Description=Borshevik App Manager (first run)
# Pulled in by the GNOME session, never pulling its targets in: see @Services#guidelines.
After=gnome-session@gnome.target
PartOf=gnome-session@gnome.target
ConditionPathExists=!%h/.local/state/borshevik/app-manager-first-run.done

[Service]
Type=oneshot
ExecStart=/usr/bin/borshevik-app-manager-first-run

[Install]
WantedBy=gnome-session@gnome.target
