#!/usr/bin/env bash
# Installs, upgrades and removes Android (Waydroid) on this machine.
# Run under pkexec by the Image Manager, as root by borshevik-modules (the App
# Manager) and by borshevik-waydroid-update.service. See @WaydroidApp in spec/.
#
#   borshevik-waydroid rendering   any user: prints `software` or `hardware`
#   borshevik-waydroid install     root
#   borshevik-waydroid upgrade     root
#   borshevik-waydroid remove      root
#   borshevik-waydroid google      root: the ID to register the device with Google,
#                                  and whether Android has signed in to it
set -euo pipefail

# Never exit with 126 or 127: pkexec returns those when the password is
# refused, and callers tell a cancelled prompt from a broken install by them.
# An operation that held the busy lock leaves in the busy file, on the way out,
# which operation ended and when.
trap 'rc=$?; if [[ -n "${BUSY_HELD:-}" ]]; then printf "done %s %s\n" "$BUSY_HELD" "$(date +%s%N)" > "$BUSY"; fi; if [[ $rc -eq 126 || $rc -eq 127 ]]; then exit 1; fi' EXIT

STAMP=/var/lib/borshevik/waydroid-installed
WAYDROID_DIR=/var/lib/waydroid
WAYDROID_CFG="${WAYDROID_DIR}/waydroid.cfg"
WAYDROID_SCRIPT_DIR=/usr/lib/borshevik/waydroid_script
SHARE=/usr/share/borshevik/waydroid
CONFIG="${SHARE}/config.json"
ANDROID_ENTRY_SRC="${SHARE}/borshevik-android.desktop"
ANDROID_ENTRY_DEST=/usr/local/share/applications/borshevik-android.desktop
# Android's own list of its apps, where they are updated and uninstalled.
APPS_ENTRY_SRC="${SHARE}/borshevik-android-apps.desktop"
APPS_ENTRY_DEST=/usr/local/share/applications/borshevik-android-apps.desktop
# What opens an APK while Android is installed: the installer's entry, and the
# one line of /usr/local's mimeapps.list that makes it the default over
# /usr/share's archive manager.
APK_ENTRY_SRC="${SHARE}/borshevik-apk-install.desktop"
APK_ENTRY_DEST=/usr/local/share/applications/borshevik-apk-install.desktop
MIMEAPPS_DEST=/usr/local/share/applications/mimeapps.list
APK_MIME=application/vnd.android.package-archive
UPDATE_TIMER=borshevik-waydroid-update.timer
# The user service handing Android GNOME's colours.
THEME_SYNC=borshevik-android-theme.service
# An OTA channel listing only the images config.json approves, written from it
# before every init and upgrade; Waydroid builds the files' paths from it.
CHANNEL_DIR=/var/lib/borshevik/waydroid-ota
SYSTEM_CHANNEL="file://${CHANNEL_DIR}/system"
VENDOR_CHANNEL="file://${CHANNEL_DIR}/vendor"
GSF_DB=.local/share/waydroid/data/data/com.google.android.gsf/databases/gservices.db
ACCOUNTS_DB=.local/share/waydroid/data/system_ce/0/accounts_ce.db
# Reads both, for this script and for the Image Manager.
ACCOUNTS_TOOL=/usr/libexec/borshevik/borshevik-waydroid-accounts
# `<operation> <pid>` while install, upgrade or remove runs, under an flock;
# `done <operation> <nanoseconds since the epoch>` once one has ended. Read by
# the Image Manager.
BUSY=/run/borshevik/waydroid-busy
OVERLAY_SYSTEM="${WAYDROID_DIR}/overlay/system"

step() { echo "==> $*"; }

# Takes the busy lock for one operation, or refuses with exit 4 when another
# holds it. The lock is the open fd 9 and goes with this process.
take_busy() { # operation
    mkdir -p "$(dirname "$BUSY")"
    chmod 0755 "$(dirname "$BUSY")"
    exec 9<>"$BUSY"
    chmod 0644 "$BUSY"
    if ! flock -n 9; then
        echo "Another Android operation is running: $(sed -n 's/^\(install\|upgrade\|remove\) [0-9]*$/\1/p' "$BUSY")" >&2
        exit 4
    fi
    BUSY_HELD="$1"
    echo "$1 $$" > "$BUSY"
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "borshevik-waydroid $1 must run as root" >&2
        exit 1
    fi
}

# `software` when no GPU render node belongs to a driver Android can render on:
# every one is the NVIDIA driver's - Waydroid gets no acceleration from the
# proprietary driver - or virtio's - in a virtual machine without 3D, Android's
# hardware rendering crashes SurfaceFlinger in a loop and it never boots. A
# hybrid laptop has another render node beside NVIDIA's, which Waydroid takes,
# so it is `hardware`. Every virtio GPU counts as unable, virgl 3D included:
# slower there, but it works; telling them apart is left for later.
cmd_rendering() {
    local node driver found=0
    for node in /sys/class/drm/renderD*; do
        [[ -e "$node/device/driver" ]] || continue
        found=1
        driver="$(basename "$(readlink -f "$node/device/driver")")"
        case "$driver" in
            nvidia|virtio-pci|virtio_gpu) ;;
            *) echo hardware; return ;;
        esac
    done
    if [[ $found -eq 1 ]]; then echo software; else echo hardware; fi
}

# The Android version (11, 13) of the installed system image, read from its
# build.prop without mounting it.
android_version() {
    local img="${WAYDROID_DIR}/images/system.img" prop version
    for prop in /system/build.prop /build.prop; do
        version="$(debugfs -R "cat $prop" "$img" 2>/dev/null \
            | sed -n 's/^ro\.build\.version\.release=//p' | head -n1)"
        if [[ -n "$version" ]]; then
            echo "${version%%.*}"
            return
        fi
    done
    echo "cannot read the Android version from $img" >&2
    return 1
}

# The ARM translation layer for this CPU: libhoudini is Intel's own and runs
# best on Intel; libndk_translation is Google's, from ChromeOS, and is the one
# that works well on AMD. Any other x86_64 vendor gets libndk too.
cpu_vendor() {
    sed -n 's/^vendor_id[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1
}
translation_layer() { # cpu vendor
    case "$1" in
        GenuineIntel) echo "libhoudini" ;;
        AuthenticAMD) echo "libndk" ;;
        *)            echo "libndk" ;;
    esac
}

# The ARM translation layer, for one Android version.
install_addons() {
    local version="$1" translation vendor
    vendor="$(cpu_vendor)"
    translation="$(translation_layer "$vendor")"
    step "CPU vendor ${vendor:-unknown}: using ${translation} for ARM apps"
    step "Installing ${translation} for Android ${version}"
    "${WAYDROID_SCRIPT_DIR}/venv/bin/python3" "${WAYDROID_SCRIPT_DIR}/main.py" \
        -a "$version" install "$translation"
}

firewall_trust() { # add | remove
    if firewall-cmd --state >/dev/null 2>&1; then
        firewall-cmd --permanent --zone=trusted "--$1-interface=waydroid0" >/dev/null || true
        firewall-cmd --zone=trusted "--$1-interface=waydroid0" >/dev/null || true
    else
        firewall-offline-cmd --zone=trusted "--$1-interface=waydroid0" >/dev/null || true
    fi
}

# Writes config.json's properties into waydroid.cfg's [properties], adding
# its software_rendering ones when this machine renders in software and
# taking them out when it does not; Waydroid builds waydroid.prop from them
# at its next upgrade. Other properties there (the translation layer's) stay.
apply_settings() {
    local rendering
    rendering="$(cmd_rendering)"
    if [[ "$rendering" == "software" ]]; then
        step "No GPU here Android can render on: switching it to software rendering"
    fi
    python3 - "$WAYDROID_CFG" "$CONFIG" "$rendering" <<'EOF'
import configparser, json, sys
path, config_path, rendering = sys.argv[1:4]
settings = json.load(open(config_path))
cfg = configparser.ConfigParser()
cfg.optionxform = str
cfg.read(path)
if not cfg.has_section("properties"):
    cfg.add_section("properties")
props = cfg["properties"]
for key, value in settings["properties"].items():
    props[key] = value
for key, value in settings["software_rendering"].items():
    if rendering == "software":
        props[key] = value
    else:
        props.pop(key, None)
with open(path, "w") as f:
    cfg.write(f)
EOF
}

# The romtype config.json approves for an image (system or vendor); the
# system's is the system type init is to ask for.
romtype() { # system | vendor
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["images"][sys.argv[2]]["romtype"])' "$CONFIG" "$1"
}
# Where in the channel Waydroid looks for each image's entry — its own layout,
# written down here only — as the URL waydroid.cfg names it by. Called inside
# $(…), where set -e does not reach, so a failure is returned explicitly.
system_ota() { local t; t="$(romtype system)" || return 1; echo "${SYSTEM_CHANNEL}/lineage/waydroid_x86_64/${t}.json"; }
vendor_ota() { local t; t="$(romtype vendor)" || return 1; echo "${VENDOR_CHANNEL}/waydroid_x86_64/${t}.json"; }

# Writes the channel from config.json's approved images, one entry each, at
# the system and vendor OTA URLs given.
write_channel() { # system OTA URL, vendor OTA URL
    python3 - "$CONFIG" "$1" "$2" <<'EOF'
import json, os, sys
config_path, system_ota, vendor_ota = sys.argv[1:4]
images = json.load(open(config_path))["images"]
for url, entry in ((system_ota, images["system"]), (vendor_ota, images["vendor"])):
    path = url.removeprefix("file://")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump({"response": [entry]}, f, indent=2)
EOF
}

# Points waydroid.cfg at the channel and resets the recorded datetime of every
# image that is not the approved one, newer or older: `waydroid upgrade` only
# fetches a build newer than the installed one, and an approved build is older
# when a broken one was withdrawn.
follow_channel() { # system OTA URL, vendor OTA URL
    python3 - "$WAYDROID_CFG" "$CONFIG" "$1" "$2" <<'EOF'
import configparser, json, sys
path, config_path, system_ota, vendor_ota = sys.argv[1:5]
images = json.load(open(config_path))["images"]
otas = {"system": system_ota, "vendor": vendor_ota}
cfg = configparser.ConfigParser()
cfg.optionxform = str
cfg.read(path)
w = cfg["waydroid"]
for image, ota in otas.items():
    approved = images[image]
    w[f"{image}_ota"] = ota
    if w.get(f"{image}_datetime") != str(approved["datetime"]):
        print(f"==> The {image} image is not the approved one: {approved['filename']}")
        w[f"{image}_datetime"] = "0"
with open(path, "w") as f:
    cfg.write(f)
EOF
}

# Applies config.json's android_settings inside Android once, on its first
# boot: its settings live in user data that exists only after one. An init
# service in the system overlay runs a script that puts each setting unless
# persist.borshevik.defaults says it already did, so a setting the user
# changes later stays changed.
write_first_boot() {
    mkdir -p "${OVERLAY_SYSTEM}/etc/init"
    cat > "${OVERLAY_SYSTEM}/etc/init/borshevik.rc" <<'EOF'
service borshevik_defaults /system/bin/sh /system/etc/borshevik-defaults.sh
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1
    start borshevik_defaults
EOF
    python3 - "$CONFIG" > "${OVERLAY_SYSTEM}/etc/borshevik-defaults.sh" <<'EOF'
import json, shlex, sys
settings = json.load(open(sys.argv[1])).get("android_settings", {})
print("#!/system/bin/sh")
print("# Written by borshevik-waydroid from config.json: Android settings applied once.")
print('[ "$(getprop persist.borshevik.defaults)" = 1 ] && exit 0')
for namespace, values in settings.items():
    for key, value in values.items():
        print(f"settings put {shlex.quote(namespace)} {shlex.quote(key)} {shlex.quote(str(value))}")
print("setprop persist.borshevik.defaults 1")
EOF
    chmod 0644 "${OVERLAY_SYSTEM}/etc/init/borshevik.rc" "${OVERLAY_SYSTEM}/etc/borshevik-defaults.sh"
}

# Android's colours, as theme-sync hands them over: persist.borshevik.theme,
# `<rrggbb> <dark|light>`, applied by an init service once Android has booted
# and whenever the property changes. The colour becomes Android's Material You
# seed (theme_customization_overlay_packages), the mode its dark theme.
write_theme() {
    mkdir -p "${OVERLAY_SYSTEM}/etc/init"
    cat > "${OVERLAY_SYSTEM}/etc/init/borshevik-theme.rc" <<'EOF'
service borshevik_theme /system/bin/sh /system/etc/borshevik-theme.sh
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1
    start borshevik_theme

on property:persist.borshevik.theme=*
    restart borshevik_theme
EOF
    cat > "${OVERLAY_SYSTEM}/etc/borshevik-theme.sh" <<'EOF'
#!/system/bin/sh
# Written by borshevik-waydroid: Android's colours follow GNOME's.
# A persistent property is loaded before Android's settings can be written;
# the boot trigger applies it once they can.
[ "$(getprop sys.boot_completed)" = 1 ] || exit 0
set -- $(getprop persist.borshevik.theme)
color="$1" mode="$2"
case "$color" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) exit 0 ;;
esac
want="{\"android.theme.customization.system_palette\":\"$color\",\"android.theme.customization.accent_color\":\"$color\",\"android.theme.customization.color_source\":\"preset\",\"android.theme.customization.theme_style\":\"VIBRANT\"}"
[ "$(settings get secure theme_customization_overlay_packages)" = "$want" ] ||
    settings put secure theme_customization_overlay_packages "$want"
case "$mode" in
    dark) cmd uimode night yes ;;
    light) cmd uimode night no ;;
esac
EOF
    chmod 0644 "${OVERLAY_SYSTEM}/etc/init/borshevik-theme.rc" "${OVERLAY_SYSTEM}/etc/borshevik-theme.sh"
}

# Notes once, inside Android, that it has signed in to Google: a flag in its
# /data, which the user's ~/.local/share/waydroid/data is and anyone may pass
# through, so the Image Manager reads it for any user without a password or a
# running Android. Looks when Android has booted and then once an hour until it
# has seen a Google account, then never again.
write_google_watch() {
    mkdir -p "${OVERLAY_SYSTEM}/etc/init"
    cat > "${OVERLAY_SYSTEM}/etc/init/borshevik-google.rc" <<'EOF'
service borshevik_google /system/bin/sh /system/etc/borshevik-google.sh
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1
    start borshevik_google
EOF
    cat > "${OVERLAY_SYSTEM}/etc/borshevik-google.sh" <<'EOF'
#!/system/bin/sh
# Written by borshevik-waydroid: notes once that Android has signed in to Google.
flag=/data/borshevik/google-signed-in
[ -e "$flag" ] && exit 0
until dumpsys account 2>/dev/null | grep -qF 'type=com.google}'; do
    sleep 3600
done
mkdir -p "${flag%/*}"
chmod 0755 "${flag%/*}"
: > "$flag"
chmod 0644 "$flag"
EOF
    chmod 0644 "${OVERLAY_SYSTEM}/etc/init/borshevik-google.rc" "${OVERLAY_SYSTEM}/etc/borshevik-google.sh"
}

# Game controllers' key layouts that Android loads only after finding their
# driver in /proc/config.gz, which the container does not have, so it falls
# back to layouts for the generic HID driver and the buttons come out wrong.
# For each such layout in the installed image whose driver the running kernel
# builds, a copy without that check goes into the system overlay in its place.
# Only copies carrying KEYLAYOUT_MARK are replaced.
KEYLAYOUT_MARK="# Written by borshevik-waydroid: Android's layout without its kernel config check"
keylayouts_digest() {
    { cat "${OVERLAY_SYSTEM}"/usr/keylayout/*.kl 2>/dev/null || true; } | sha256sum
}
write_keylayouts() {
    local dir="${OVERLAY_SYSTEM}/usr/keylayout" kconfig tmp f name opt ok
    kconfig="/usr/lib/modules/$(uname -r)/config"
    mkdir -p "$dir"
    for f in "$dir"/*.kl; do
        if [[ -f "$f" && "$(head -n1 "$f")" == "$KEYLAYOUT_MARK" ]]; then
            rm -f "$f"
        fi
    done
    if [[ ! -r "$kconfig" ]]; then
        echo "cannot read $kconfig; controllers keep Android's fallback layouts" >&2
        return 0
    fi
    tmp="$(mktemp -d)"
    debugfs -R "rdump /system/usr/keylayout $tmp" "${WAYDROID_DIR}/images/system.img" >/dev/null 2>&1 || true
    for f in "$tmp"/keylayout/*.kl; do
        if [[ ! -f "$f" ]] || ! grep -q '^requires_kernel_config' "$f"; then
            continue
        fi
        ok=1
        for opt in $(sed -n 's/#.*//; s/^requires_kernel_config[[:space:]]\{1,\}//p' "$f"); do
            if ! grep -qE "^${opt}=(y|m)\$" "$kconfig"; then
                ok=
            fi
        done
        if [[ -n "$ok" ]]; then
            name="$(basename "$f")"
            { echo "$KEYLAYOUT_MARK"; grep -v '^requires_kernel_config' "$f"; } > "${dir}/${name}"
            chmod 0644 "${dir}/${name}"
            step "Controller layout ${name} for this kernel"
        fi
    done
    rm -rf "$tmp"
}

# Sets or unsets the APK association in /usr/local's mimeapps.list, and nothing
# else there: the file may hold an administrator's own defaults, an APK default
# of their own among them, which set leaves in place and unset does not touch.
# It is created when missing and deleted when unsetting leaves nothing in it;
# rewritten only when it changes, through a new file put in its place.
apk_association() { # set | unset
    python3 - "$MIMEAPPS_DEST" "$APK_MIME" "$(basename "$APK_ENTRY_DEST")" "$1" <<'EOF'
import os, sys
path, mime, entry, action = sys.argv[1:5]
ours = f"{mime}={entry}"
# What the whole file this script used to copy there said of itself; untrue now.
LEGACY = ("# Copied into /usr/local/share/applications by borshevik-waydroid install, and",
          "# removed by remove: APKs open in the installer only while Android is there.")

def read():
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8", errors="surrogateescape", newline="") as f:
        return f.read()

old = read()
# Split on newlines only, so every line keeps what it ends in, a CR included;
# the line added ends the way the file's lines do, and the file ends as it did.
lines = (old or "").split("\n")
final_newline = old is None or old.endswith("\n")
if lines and lines[-1] == "":
    lines.pop()
crlf = bool(lines) and all(l.endswith("\r") for l in lines)
ours_line = ours + ("\r" if crlf else "")
header_line = "[Default Applications]" + ("\r" if crlf else "")
had_header = any(l.strip() == "[Default Applications]" for l in lines)
lines = [l for l in lines if l.strip() not in LEGACY]
key = lambda l: l.split("=", 1)[0].strip()
# An APK default of someone else's, in [Default Applications]; lines in other
# sections only offer or hide applications.
section, theirs = None, False
for l in lines:
    if l.strip().startswith("[") and l.strip().endswith("]"):
        section = l.strip()
    elif section == "[Default Applications]" and key(l) == mime and l.strip() != ours:
        theirs = True
out, section, placed = [], None, False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if section == "[Default Applications]" and action == "set" and not placed and not theirs:
            end = len(out)
            while end and not out[end - 1].strip():
                end -= 1
            out.insert(end, ours_line)
            placed = True
        section = stripped
    elif section == "[Default Applications]" and stripped == ours:
        continue
    out.append(line)
if action == "set" and not placed and not theirs:
    if section != "[Default Applications]":
        out.append(header_line)
    out.append(ours_line)
# Unsetting takes out a [Default Applications] left empty, which set added.
if action == "unset" and had_header:
    i = next(n for n, l in enumerate(out) if l.strip() == "[Default Applications]")
    rest = out[i + 1:]
    end = next((n for n, l in enumerate(rest) if l.strip().startswith("[")), len(rest))
    if not any(l.strip() for l in rest[:end]):
        out = out[:i] + rest[end:]

keep = any(l.strip() and l.strip() != "[Default Applications]" for l in out)
new = "\n".join(out) + ("\n" if final_newline else "") if keep else None
if new == old:
    sys.exit(0)
if new is None:
    os.remove(path)
    sys.exit(0)
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".borshevik-new"
with open(tmp, "w", encoding="utf-8", errors="surrogateescape", newline="") as f:
    f.write(new)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
EOF
}

# The entries that exist only while Android is installed.
install_entries() {
    install -D -m 0644 "$ANDROID_ENTRY_SRC" "$ANDROID_ENTRY_DEST"
    install -D -m 0644 "$APPS_ENTRY_SRC" "$APPS_ENTRY_DEST"
    install -D -m 0644 "$APK_ENTRY_SRC" "$APK_ENTRY_DEST"
    # Someone else's file: a failure there is reported, and stops nothing.
    apk_association set || echo "could not make APKs open in Android through ${MIMEAPPS_DEST}" >&2
}

cmd_install() {
    require_root install
    take_busy install
    rm -f "$STAMP"

    step "Downloading and installing the Android image"
    # What `init -f` keeps from a previous install: the overlays the
    # translation layer went into, and waydroid.cfg's [properties].
    rm -rf "${WAYDROID_DIR}/overlay" "${WAYDROID_DIR}/overlay_rw" "${WAYDROID_DIR}/overlay_work"
    rm -f "$WAYDROID_CFG"
    local system_type system vendor
    system="$(system_ota)"
    vendor="$(vendor_ota)"
    system_type="$(romtype system)"
    write_channel "$system" "$vendor"
    # init exits 0 even when it fails, so the images are what says it worked.
    waydroid init -f -c "$SYSTEM_CHANNEL" -v "$VENDOR_CHANNEL" -s "$system_type"
    if [[ ! -f "${WAYDROID_DIR}/images/system.img" || ! -f "${WAYDROID_DIR}/images/vendor.img" ]]; then
        echo "waydroid init did not install the Android images" >&2
        exit 1
    fi

    step "Letting Android reach the network"
    firewall_trust add

    step "Starting the Waydroid container service"
    systemctl enable --now waydroid-container.service

    local version
    version="$(android_version)"
    install_addons "$version"
    write_first_boot
    write_theme
    write_google_watch
    write_keylayouts

    apply_settings
    waydroid upgrade -o

    step "Turning on automatic Android updates"
    systemctl enable "$UPDATE_TIMER"

    install_entries

    mkdir -p "$(dirname "$STAMP")"
    chmod 0755 "$(dirname "$STAMP")"
    echo "$version" > "$STAMP"
    chmod 0644 "$STAMP"
    start_theme_sync
    step "Android ${version} is installed"
}

# theme-sync's condition kept it from starting in the session of the user who
# installed Android, which began before the stamp existed; start it there now.
start_theme_sync() {
    [[ -n "${PKEXEC_UID:-}" ]] || return 0
    local user
    user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    [[ -n "$user" ]] || return 0
    systemctl --user -M "${user}@" start "$THEME_SYNC" 2>/dev/null || true
}

cmd_upgrade() {
    require_root upgrade
    take_busy upgrade
    if [[ ! -f "$STAMP" ]]; then
        echo "Android is not installed; nothing to upgrade"
        return
    fi

    step "Updating the Android images"
    local system vendor
    system="$(system_ota)"
    vendor="$(vendor_ota)"
    write_channel "$system" "$vendor"
    follow_channel "$system" "$vendor"
    write_first_boot
    write_theme
    write_google_watch
    apply_settings
    install_entries
    waydroid upgrade

    # `waydroid upgrade` has already restarted a running Android, before what
    # follows changed its overlay; restart it again once anything did.
    local layouts restart= before after version_changed=
    layouts="$(keylayouts_digest)"
    write_keylayouts
    [[ "$(keylayouts_digest)" != "$layouts" ]] && restart=1
    before="$(<"$STAMP")"
    after="$(android_version)"
    [[ "$after" != "$before" ]] && version_changed=1
    if [[ -n "$version_changed" ]]; then
        install_addons "$after"
        restart=1
    fi
    if [[ -n "$restart" ]]; then
        waydroid upgrade -o
    fi
    if [[ -n "$version_changed" ]]; then
        echo "$after" > "$STAMP"
    fi
    step "Android ${after} is up to date"
}

cmd_remove() {
    require_root remove
    take_busy remove
    rm -f "$STAMP"
    rm -f "$ANDROID_ENTRY_DEST" "$APPS_ENTRY_DEST" "$APK_ENTRY_DEST"
    apk_association unset || echo "could not take the APK association out of ${MIMEAPPS_DEST}" >&2

    step "Stopping Android"
    systemctl disable --now "$UPDATE_TIMER" 2>/dev/null || true
    waydroid container stop 2>/dev/null || true
    systemctl disable --now waydroid-container.service 2>/dev/null || true
    firewall_trust remove

    step "Removing the Android image"
    rm -rf "$WAYDROID_DIR" "$CHANNEL_DIR"

    if [[ -n "${PKEXEC_UID:-}" ]]; then
        local home
        home="$(getent passwd "$PKEXEC_UID" | cut -d: -f6)"
        if [[ -n "$home" && -d "$home" ]]; then
            step "Removing your Android data"
            rm -rf "${home}/.local/share/waydroid"
            rm -f "${home}"/.local/share/applications/waydroid.*.desktop
        fi
    fi
    step "Android is removed"
}

# Where the asking user's Android stands with Google: the Google Services
# Framework ID to register it with, and whether it holds a Google account -
# the one sign that registration went through, as Google refuses the sign-in
# before it. Read on the host, since Android's app data belongs to Android's
# app UIDs and only root can; from copies, so a database Android is writing
# to is read whole, journal included. Exits 3 until Android has checked in.
cmd_google() {
    require_root google
    local home id rc=0 account
    home="$(getent passwd "${PKEXEC_UID:-0}" | cut -d: -f6)"
    id="$("$ACCOUNTS_TOOL" android-id "${home}/${GSF_DB}")" || rc=$?
    if [[ $rc -eq 3 ]]; then
        echo "Android has not checked in with Google yet: start Android once with network, then try again" >&2
        exit 3
    elif [[ $rc -ne 0 ]]; then
        exit 1
    fi
    # As root the file is unreadable only when it does not exist yet: no account.
    # Anything else that fails is a failure, not a "no".
    rc=0
    account="$("$ACCOUNTS_TOOL" google-account "${home}/${ACCOUNTS_DB}")" || rc=$?
    if [[ $rc -eq 2 ]]; then
        account=no
    elif [[ $rc -ne 0 ]]; then
        exit 1
    fi
    echo "android_id=${id}"
    echo "google_account=${account}"
}

case "${1:-}" in
    rendering) cmd_rendering ;;
    install)   cmd_install ;;
    upgrade)   cmd_upgrade ;;
    remove)    cmd_remove ;;
    google)    cmd_google ;;
    *)
        echo "usage: borshevik-waydroid rendering|install|upgrade|remove|google" >&2
        exit 2
        ;;
esac
